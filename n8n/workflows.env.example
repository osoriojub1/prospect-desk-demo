# Use the HTTPS project URL without the Edge Function path.
PROSPECT_DESK_SUPABASE_URL=https://your-project-ref.supabase.co

# Airtable connection IDs. Set credentials in n8n.
PROSPECT_DESK_AIRTABLE_BASE_ID=
PROSPECT_DESK_AIRTABLE_TABLE_ID=

# Set this after importing the Airtable sync workflow.
PROSPECT_DESK_AIRTABLE_SYNC_WORKFLOW_ID=
