      "name": "Workflow Error"
    },
    {
      "parameters": {
        "jsCode": "const failure = $input.first().json;\nconst occurred = Number(failure.trigger?.error?.timestamp);\nreturn [{ json: {\n  edgeUrl: '{{PROSPECT_DESK_SUPABASE_URL}}/functions/v1/outreach',\n  workflow: failure.workflow?.name ?? '',\n  executionId: failure.execution?.id != null ? String(failure.execution.id) : null,\n  occurredAt: Number.isFinite(occurred) && occurred > 0 ? new Date(occurred).toISOString() : new Date().toISOString(),\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        96,
        176
      ],
      "id": "81f1afe9-62f0-4111-87cd-9d36d594a79b",
      "name": "Workflow settings"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Workflow settings').first().json.edgeUrl }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ ({ action: 'report_error', workflow: $json.workflow, executionId: $json.executionId, occurredAt: $json.occurredAt }) }}",
        "options": {
          "timeout": 20000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        320,
