      "name": "Upsert Airtable Leads",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const { items } = $('Claim Airtable Batch').first(0, $runIndex).json;\nconst errorCodes = {\n  400: 'airtable_fields',\n  401: 'airtable_access',\n  403: 'airtable_access',\n  404: 'airtable_target',\n  422: 'airtable_fields',\n  429: 'airtable_rate_limit',\n};\nconst recordIds = new Map();\nconst errors = new Map();\nfor (const { json } of $input.all()) {\n  const leadId = json.fields?.['Lead ID'];\n  if (typeof leadId === 'string' && /^rec[A-Za-z0-9]{14}$/.test(json.id)) {\n    recordIds.set(leadId, json.id);\n  } else if (Number.isInteger(json.error?.context?.itemIndex)) {\n    errors.set(json.error.context.itemIndex, errorCodes[Number(json.error.httpCode)]);\n  }\n}\n\nreturn [{ json: { results: items.map(({ prospectId, revision }, index) => {\n  const recordId = recordIds.get(prospectId);\n  return { prospectId, revision, ...(recordId ? { recordId } : { errorCode: errors.get(index) ?? 'airtable_unconfirmed' }) };\n}) }, pairedItem: { item: 0 } }];"
      },
