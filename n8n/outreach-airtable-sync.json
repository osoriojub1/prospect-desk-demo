      "id": "cb8dfa77-7a71-471f-b454-482c11491d9d",
      "name": "Claim Airtable Batch",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "const { items } = $input.first().json;\nif (!Array.isArray(items) || items.some(lead => typeof lead?.email !== 'string' || !lead.email.trim())) {\n  throw new Error('Supabase did not return the interested lead payload.');\n}\n\n// Keep Stage in Airtable so the default applies on creation and updates preserve the pipeline.\nreturn items.map((lead) => {\n  const fields = { 'Lead ID': lead.prospectId, 'Company': lead.company, 'Email': lead.email };\n  if (lead.contact?.trim()) fields.Contact = lead.contact.trim();\n  if (lead.domain?.trim()) fields.Domain = lead.domain.trim();\n\n  const offer = lead.offer?.trim();\n  const research = lead.researchSummary?.trim();\n  const reply = lead.reply?.replace(/\\r\\n?/g, '\\n')\n    .split(/^[ \\t]*(?:On [\\s\\S]{1,300}? wrote:|[- ]+(?:Original Message|Forwarded message)[- ]+)[ \\t]*$/im)[0]\n    .split('\\n').filter(line => !/^\\s*>/.test(line)).join('\\n').trim();\n  const notes = [\n    offer && 'Outreach offer\\n' + offer,\n    research && 'Research\\n' + research,\n    reply && 'Qualifying reply\\n' + reply,\n  ].filter(Boolean);\n  if (notes.length) fields.Notes = notes.join('\\n\\n');\n\n  return { json: fields, pairedItem: { item: 0 } };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
