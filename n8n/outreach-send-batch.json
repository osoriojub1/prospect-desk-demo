      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "const batch = $input.first().json;\nif (!batch.claimed || !Array.isArray(batch.items)) return [];\nreturn batch.items.map(item => ({ json: item, pairedItem: { item: 0 } }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        144,
