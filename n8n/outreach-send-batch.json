      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst { sendItemId } = $('Authorize Email').itemMatching(0).json;\nconst okay = !response.error && typeof response.id === 'string' && response.id &&\n  typeof response.threadId === 'string' && response.threadId;\nconst status = Number(response.error?.httpCode ?? response.error?.statusCode ?? response.statusCode);\nconst definitiveRejection = [400, 401, 403, 404, 422, 429].includes(status);\n\nreturn [{ json: {\n  sendItemId,\n  outcome: okay ? 'sent' : definitiveRejection ? 'not_sent' : 'uncertain',\n  messageId: okay ? response.id : null,\n  threadId: okay ? response.threadId : null,\n}, pairedItem: { item: 0 } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
