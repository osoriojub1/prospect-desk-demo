    },
    {
      "parameters": {
        "jsCode": "const jobId = $input.first().json.body?.jobId;\nif (typeof jobId !== 'string' || !/^[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}$/i.test(jobId)) throw new Error('Missing outreach job ID');\nreturn [{ json: {\n  jobId,\n  executionId: String($execution.id),\n  edgeUrl: '{{PROSPECT_DESK_SUPABASE_URL}}/functions/v1/outreach',\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -288,
        128
      ],
      "id": "f428ab64-f264-4dcb-a175-907c8d651aeb",
      "name": "Workflow settings"
