    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Workflow settings').first().json.edgeUrl }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ ({ action: 'finish_job', jobId: $('Workflow settings').first().json.jobId, executionId: $('Workflow settings').first().json.executionId }) }}",
        "options": {
          "timeout": 20000
