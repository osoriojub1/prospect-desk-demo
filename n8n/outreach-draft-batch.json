      "name": "Draft Batch Webhook",
      "webhookId": "bcc9dfcb-5c3b-4803-a511-000000000001"
    },
    {
      "parameters": {
        "jsCode": "const jobId = $input.first().json.body?.jobId;\nif (typeof jobId !== 'string' || !/^[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}$/i.test(jobId)) throw new Error('Missing outreach job ID');\nreturn [{ json: {\n  jobId,\n  executionId: String($execution.id),\n  edgeUrl: '{{PROSPECT_DESK_SUPABASE_URL}}/functions/v1/outreach',\n  offer: 'Offer a short conversation about commercial grounds maintenance for the properties the company manages.',\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -144,
        128
      ],
      "id": "80fa1b16-1558-4cc4-a60f-373451ae63c5",
      "name": "Workflow settings"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Workflow settings').first().json.edgeUrl }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ ({ action: 'claim_job', jobId: $('Workflow settings').first().json.jobId, executionId: $('Workflow settings').first().json.executionId, kind: 'draft' }) }}",
        "options": {
          "timeout": 20000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        80,
        128
      ],
      "id": "87932da7-c387-493c-b397-9d5ef4eebccc",
      "name": "Claim Draft Batch",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "const batch = $input.first().json;\nif (!batch.claimed || !Array.isArray(batch.items)) return [];\nconst settings = $('Workflow settings').first().json;\nreturn batch.items.map(item => {\n  const { offer, emailKind, contact, ...research } = item.research;\n  return {\n    json: {\n      ...item, research, offer: offer ?? settings.offer,\n      greetingName: emailKind === 'direct' ? contact?.name ?? null : null,\n    },\n    pairedItem: { item: 0 },\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        288,
        128
      ],
      "id": "a00d7471-029c-423e-bb09-c1cbe404e458",
      "name": "Load Draft Items"
    },
    {
      "parameters": {
        "options": {}
      },
